# Telegram Bot Token (required)
TELEGRAM_BOT_TOKEN=

# Web App URL (required) - Render sets RENDER_EXTERNAL_URL automatically
WEB_APP_URL=

# Admin Telegram username
ADMIN_USERNAME=

# Telegram Channel ID for backup (optional)
TELEGRAM_CHANNEL_ID=

# Data directory for persistent storage (default: ./data)
DATA_DIR=/data

# Node environment
NODE_ENV=production
